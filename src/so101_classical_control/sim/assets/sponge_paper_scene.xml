<mujoco model="so101_sponge_paper">
  <include file="robotstudio_so101/so101.xml"/>
  <compiler angle="radian" meshdir="robotstudio_so101/assets" autolimits="true"/>

  <statistic center="0.15 0 0.15" extent="0.5"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.25 0.25 0.25" specular="0 0 0"/>
    <global azimuth="160" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="desk_texture" builtin="checker" mark="edge" rgb1="0.55 0.40 0.28"
      rgb2="0.48 0.34 0.23" markrgb="0.6 0.5 0.4" width="300" height="300"/>
    <material name="desk_material" texture="desk_texture" texuniform="true" texrepeat="2 2"
      reflectance="0.1"/>
    <material name="sponge_material" rgba="0.95 0.75 0.10 1"/>
    <material name="paper_material" rgba="0.95 0.95 0.92 1"/>
  </asset>

  <worldbody>
    <light pos="0.2 0 1.5" dir="0 0 -1" directional="true"/>

    <!-- Desk-fixed overview camera (`top_cam`), eye-to-hand.
      Role-level approximation of the Applied1 2026-10-26 Logitech C920 that sat on the
      right edge of the desk, 16 cm back from the front edge, looking at the paper, the
      sponge, and the follower arm. The real camera sat on a VIJIM LS08 arm whose height
      and tilt were never measured, so only the role is reproduced here, not the geometry.
      The Applied1 world numbers (0.16, -0.665) belong to a different, larger desk and are
      not reused.
      Placement: right (-Y) edge of this desk, near the base side of the workspace, and
      above it. xyaxes gives camera X = image right, camera Y = image up, so the look
      direction (-Z) points at (0.30, 0, 0), the sponge/paper cluster, 0.711 m away and
      57.6 degrees below horizontal. fovy = 52 degrees is the C920's 78 degree diagonal at
      4:3; from this pose it covers the arm, the sponge, and the paper at 320x240. -->
    <camera name="top_cam" mode="fixed" pos="0.303213 -0.061406 0.512713"
      xyaxes="0.979439 -0.196093 -0.047394 0.194306 0.980133 -0.039808" fovy="52"/>

    <!-- Desk. The top surface is at z = 0, the height of the robot base. -->
    <body name="desk" pos="0.35 0.035 -0.02">
      <geom name="desk" type="box" size="0.35 0.70 0.02" material="desk_material"
        friction="1 0.005 0.0001"/>
    </body>

    <!-- Marker frame for the eye-in-hand AX=XB step (Issue #8), on the desk top surface
      (z = 0) between the paper and the sponge, clear of both. Frame only: geometry and
      textures for image-based detection are deferred. Orientation is the identity
      relative to the world frame, which the desk shares because it is axis-aligned; the
      site is static, since the desk is static. group = 3 matches the other frame sites. -->
    <site name="desk_marker" pos="0.30 0 0" quat="1 0 0 0" group="3"/>

    <!-- Sponge resting on the desk, in front of the arm. -->
    <body name="sponge" pos="0.44 -0.125 0.015">
      <freejoint name="sponge_free"/>
      <geom name="sponge" type="box" size="0.055 0.03 0.015" material="sponge_material"
        mass="0.02" friction="1 0.02 0.001"/>
    </body>

    <!-- Paper on the desk. Intentionally fixed (no freejoint, no mass) as the placement target,
      unlike the sponge. -->
    <body name="paper" pos="0.27 0.025 0.001">
      <geom name="paper" type="box" size="0.15 0.10 0.001" material="paper_material"
        friction="1 0.01 0.0005"/>
    </body>
  </worldbody>
</mujoco>
